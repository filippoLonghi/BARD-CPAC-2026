# Template for local development on your laptop.
# Copy this to a private .env file, but do not commit real values.
#
# Suggested layout:
# <workspace>/BARD-CPAC-2026
# <workspace>/Project/secrets/bard-local.env
#
# Use with:
# $WORKSPACE=(Resolve-Path ..).Path
# $ENV_FILE=Join-Path $WORKSPACE "Project\secrets\bard-local.env"
# See docs/running_the_pipeline.md for current run-fragments and replay commands.

BARD_AUDIO_PROVIDER=gemini
BARD_STORY_PROVIDER=vertex
BARD_OUTPUT_DIR=runs
BARD_LABELBANK_PATH=data/labelbanks/clap_unified_labelbank.json
BARD_DEFAULT_CHUNK_S=30
BARD_READING_WPM=120
BARD_TEXT_COVERAGE=0.72
BARD_STORY_LANGUAGE=English
BARD_STORY_LEVEL=children
BARD_TARGET_WORDS_PER_FRAGMENT=72
BARD_MUSIC_WINDOW_S=15
BARD_STORY_SCENE_S=60
BARD_PROCESSING_STARTUP_DELAY_S=1.5
BARD_OSC_HOST=127.0.0.1
BARD_OSC_PORT=5005
BARD_OSC_READY_PORT=5007
BARD_PROCESSING_READY_TIMEOUT_S=8

# Vertex/Gemini settings. Required when BARD_AUDIO_PROVIDER=gemini or BARD_STORY_PROVIDER=vertex.
BARD_GCP_PROJECT_ID=your-gcp-project-id
BARD_GCP_LOCATION=europe-west1
BARD_VERTEX_AUDIO_MODEL=gemini-2.5-flash
BARD_VERTEX_TEXT_MODEL=gemini-2.5-flash
BARD_STORAGE_BUCKET=your-gcp-project-id-bard-artifacts

# Optional image keyframes. Scalable/default path uses Vertex AI Imagen on GCP.
# Image generation still runs only when you pass --generate-images or the generate-images command.
BARD_IMAGE_PROVIDER=imagen
BARD_MAX_IMAGE_ASSETS=3
BARD_IMAGE_ASPECT_RATIO=1:1
BARD_IMAGE_TIMEOUT_S=120

# Vertex AI Imagen, used only with --generate-images --image-provider imagen.
BARD_IMAGEN_MODEL=imagen-4.0-fast-generate-001
BARD_IMAGEN_LOCATION=europe-west1

# Optional non-GCP experiment, not needed for the scalable path.
# BARD_REPLICATE_MODEL=black-forest-labs/flux-schnell
# BARD_REPLICATE_API_TOKEN=paste-your-replicate-token-here

# Also used by the Google Gen AI SDK.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_GENAI_USE_VERTEXAI=true

# Usually not needed because local dev should use:
# gcloud auth application-default login
#
# If ADC fails, uncomment this and keep the JSON key outside the repo.
# GOOGLE_APPLICATION_CREDENTIALS=<workspace>/Project/secrets/bard-gcp-key.json

# Optional, only for local Hugging Face models.
# HF_TOKEN=paste-your-huggingface-token-here
