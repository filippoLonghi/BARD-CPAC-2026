# BARD local development environment template.
# Copy this to your private env file, for example:
#
#   <workspace>/Project/secrets/bard-local.env
#
# Do not commit your real private env file.
#
# Keep this file focused on account/project-specific values. Shared artistic
# defaults live in src/bard_core/config.py, and one-run experiments can use CLI
# flags.

# Required for Vertex AI / Gemini.
BARD_GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
BARD_GCP_LOCATION=europe-west1
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_GENAI_USE_VERTEXAI=true

# Optional: uncomment to copy completed local runs to Google Cloud Storage.
# If this is set, run-fragments uploads the finished run directory after local
# files are written.
# BARD_STORAGE_BUCKET=your-gcp-project-id-bard-artifacts

# Optional: usually not needed after `gcloud auth application-default login`.
# If ADC fails, point this at a private JSON key outside the repo.
# GOOGLE_APPLICATION_CREDENTIALS=<workspace>/Project/secrets/bard-gcp-key.json

# Optional: only needed for paid Replicate image experiments.
# BARD_REPLICATE_API_TOKEN=paste-your-replicate-token-here
